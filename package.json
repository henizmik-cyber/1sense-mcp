{
  "name": "onesense-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "1Sense Data — German Property MCP server (NRW parcels, Bodenrichtwerte, company lookups; owner chains via early access)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply onesense --local",
    "db:migrate:remote": "wrangler d1 migrations apply onesense --remote",
    "seed:local": "wrangler d1 execute onesense --local --file scripts/seed-dev.sql && node scripts/seed-geo-local.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "agents": "^0.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@cloudflare/workers-types": "^5.20261125.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.168.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261123.1": true,
    "core-js-pure@3.51.0": true
  }
}
